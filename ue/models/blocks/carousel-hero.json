{
  "definitions": [
    {
      "title": "Carousel Hero",
      "id": "carousel-hero",
      "model": "carousel-hero",
      "filter": "carousel-hero",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1
        }
      }
    },
    {
      "title": "Carousel Hero Slide",
      "id": "carousel-hero-item",
      "model": "carousel-hero-item",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1,
          "fields": [
            { "name": "backgroundImage", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "backgroundImageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "carousel-hero-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "backgroundImage",
          "label": "Background Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "backgroundImageAlt",
          "label": "Background Image Alt"
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "carousel-hero",
      "components": ["carousel-hero-item"]
    }
  ]
}
